{
  "api_keys": {
    "openai": null,
    "gemini": null,
    "openrouter": null
  },
  "providers": {
    "openai": {
      "enabled": true,
      "use_openrouter": true,
      "model": "gpt-6-astra",
      "endpoint": "https://api.openai.com/v1",
      "openrouter_model": {
        "none": "openai/gpt-6-astra",
        "web": "openai/gpt-6-astra:online"
      }
    },
    "gemini": {
      "enabled": true,
      "use_openrouter": true,
      "model": "gemini-4-argon",
      "endpoint": "https://generativelanguage.googleapis.com/v1beta",
      "openrouter_model": {
        "none": "google/gemini-4-argon",
        "web": "google/gemini-4-argon:online"
      }
    },
    "deepseek": {
      "enabled": true,
      "use_openrouter": true,
      "model": "deepseek-v4-pro-0813",
      "openrouter_model": {
        "none": "deepseek/deepseek-v4-pro-0813",
        "web": "deepseek/deepseek-v4-pro-0813:online"
      }
    }
  },
  "settings": {
    "default_search_mode": "web",
    "max_tokens": 4000,
    "max_tokens_gemini": 32768,
    "temperature": 0.7,
    "concurrent_requests": true
  },
  "endpoints": {
    "openai": "https://api.openai.com/v1",
    "gemini": "https://generativelanguage.googleapis.com/v1beta",
    "openrouter": "https://openrouter.ai/api/v1"
  }
}
